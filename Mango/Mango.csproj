<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Mango.Libbpf</PackageId>
    <!-- Overridden at pack time via -p:Version=$VERSION in the release workflow, off the pushed git tag. -->
    <Version>0.0.1</Version>
    <Authors>Yekuuun</Authors>
    <Description>A C# wrapper around the native libbpf library, exposing eBPF object/program/map loading through P/Invoke.</Description>
    <PackageTags>ebpf;bpf;libbpf;linux;pinvoke</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Yekuuun/Mango</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Yekuuun/Mango</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
